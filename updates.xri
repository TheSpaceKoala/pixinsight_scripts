      <package fileName="TheSpaceKoalaScripts_20261110.zip" sha1="cefa9ed756cd8c690fef6c6b3eb311ba7ba1d573" type="script" releaseDate="20261110">
         <title>
        Documentation and update-package compliance correction
      </title>
         <remove>
        src/scripts/TheSpaceKoala/TelegramEventScript.js,
        src/scripts/TheSpaceKoala/TelegramEventScript.xsgn,
        src/scripts/TheSpaceKoala/SendImageToTelegram.js,
        src/scripts/TheSpaceKoala/SendImageToTelegram.xsgn,
        doc/scripts/SendImageToTelegram,
        doc/docs/WBPP Telegram Notification Event Script
      </remove>
         <description>
            <p>Removes all PixInsight-owned doc/pidoc resources from the update payload. No PixInsight-owned files are scheduled for removal.</p>
            <p>Includes signatures for NormalizeExposureRegion and CenterCrop2200.</p>
            <p>Documents messaging endpoints, curl and osascript, retained temporary JPEGs, automatic WBPP master-image delivery, Discord configuration, and the Windows TLS retry.</p>
            <p>Retains the existing WBPP compatibility and notification fixes without changing script behavior.</p>
         </description>
      </package>
