<xri version="1.0">
   <description>
      <p>
      The Space Koala PixInsight Scripts Repository
    </p>
   </description>
   <platform os="all" arch="noarch" version="1.8.9-2:1.9.99">
      <package fileName="TheSpaceKoalaScripts_20260801.zip" sha1="2fea25a3ce0db787e29ca6b5866b104b2259ecf3" type="script" releaseDate="20260801">
         <title>
        WBPP reuse-reference and notification validation fixes
      </title>
         <remove>
        src/scripts/TheSpaceKoala/TelegramEventScript.js,
        src/scripts/TheSpaceKoala/TelegramEventScript.xsgn,
        src/scripts/TheSpaceKoala/SendImageToTelegram.js,
        src/scripts/TheSpaceKoala/SendImageToTelegram.xsgn,
        doc/scripts/SendImageToTelegram,
        doc/docs/WBPP Telegram Notification Event Script
      </remove>
         <description>
            <p>
          Fixes NotificationEventScript validation under WBPP 3.0.1 by removing syntax that is forbidden in its strict V8 execution context.
            </p>
            <p>
          Fixes Measurements failures in NoCodePipelineBuilder and MultiScopeStacker when Reuse Last Registration Reference Frames is enabled by ensuring WBPP reference-frame data is prepared whenever Measurements is scheduled.
            </p>
            <p>
          Includes the previous WBPP 3.0.1 compatibility, notification reliability, Windows curl compatibility, and installer permission fixes.
            </p>
         </description>
      </package>
   </platform>
</xri>
