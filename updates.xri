   <description>
      <p>
      The Space Koala PixInsight Scripts Repository
    </p>
   </description>
   <platform os="all" arch="noarch" version="1.8.9-2:1.9.99">
      <package fileName="TheSpaceKoalaScripts_20260730.zip" sha1="a41a89bc5aeb6a1fb4a97b12667e9b2bd1538819" type="script" releaseDate="20260730">
         <title>
        WBPP 3.0.1 compatibility and notification reliability update
      </title>
         <remove>
        src/scripts/TheSpaceKoala/TelegramEventScript.js,
        src/scripts/TheSpaceKoala/TelegramEventScript.xsgn,
        src/scripts/TheSpaceKoala/SendImageToTelegram.js,
        src/scripts/TheSpaceKoala/SendImageToTelegram.xsgn,
        doc/scripts/SendImageToTelegram,
        doc/docs/WBPP Telegram Notification Event Script
      </remove>
         <description>
            <p>
          Fixes second-run WBPP measurement failures caused by invalid process table rows and preserves the Image Registration reuse-reference-frames preference.
            </p>
            <p>
          Updates NoCodePipelineBuilder and MultiScopeStacker for WBPP 3.0.1, including current constants, single-pass linear pattern subtraction scheduling, and corrected fast-integration handling.
            </p>
            <p>
          Improves notification scripts with self-contained event-script utilities, corrected image resampling, text-only sending without an active image, and a Windows curl SSL compatibility retry for affected older curl installations.
            </p>
         </description>
      </package>
   </platform>
